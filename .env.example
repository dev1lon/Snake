# Copy the relevant block into backend/.env and frontend/.env for local work.
# In production these live in the Render dashboard (see render.yaml).

# ── Backend ──────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Public URL of the frontend. Drives CORS, the CSRF origin check and the set
# of domains a SIWE sign-in message is allowed to carry.
FRONTEND_ORIGIN=https://base-snake.app

# Extra origins, comma-separated: preview deploys, a second domain.
# ADDITIONAL_ORIGINS=https://snake-preview.onrender.com

# Dedicated Base RPC. Each login verifies a Smart Wallet signature with an
# eth_call; the default public endpoint rate-limits under real traffic.
# RPC_URL=https://api.developer.coinbase.com/rpc/v1/base/<key>
# Get this from CDP > Node > Base Mainnet; gas sponsorship need not be enabled.

# Sessions, streaks, runs and revive usage persist here. Without it they all
# live in process memory and are lost on every restart, sleep and redeploy.
# DATABASE_URL=postgres://user:password@host:5432/snake
# DATABASE_SSL=true

# SnakeArcade address. The backend reads run events and revive purchases from
# it: a score only enters the database if a transaction to this contract
# recorded it. The deployed address is the default; set this only to point at
# another one.
# ARCADE_CONTRACT_ADDRESS=0xd3a355586a035bAA80eA56d6D8627b0F64141D78

# Base App notifications. BASE_NOTIFICATIONS_API_KEY is accepted as an alias.
# BASE_API_KEY=
# BASE_APP_URL=https://base-snake.app

# Who may trigger the broadcast notification. ADMIN_ADDRESSES takes a
# comma-separated list; ADMIN_WALLET_ADDRESS is the single-address alias.
# ADMIN_WALLET_ADDRESS=0x...
# ADMIN_ADDRESSES=0x...,0x...

# CDP Paymaster endpoint proxied by /api/paymaster. PAYMASTER_URL is an alias.
# Keep the contract and call-policy allowlist configured on the CDP side —
# the proxy only adds rate limits on top of it.
# CDP_PAYMASTER_URL=https://api.developer.coinbase.com/rpc/v1/base/<key>

# ── Frontend ─────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000
VITE_RECORD_CONTRACT_ADDRESS=0x9e5d82E6B6419C066Bc57F5a70116659c468d780

# SnakeArcade — saving a run and buying revives both go here. Prices are held
# in the contract in cents and converted through the Chainlink ETH/USD feed.
# The deployed address is the default; set this only to point at another one.
# VITE_ARCADE_CONTRACT_ADDRESS=0xd3a355586a035bAA80eA56d6D8627b0F64141D78
VITE_BUILDER_CODE_SUFFIX=0x62635f38776576327439680b0080218021802180218021802180218021

# Domain-restricted RPC key for wallet reads and Basename lookups.
# VITE_RPC_URL=

# Base App gate. Off by default: the site opens in any browser, as it always
# has. Set this to "true" and a browser that isn't Base App is sent to
# /gate.html — a standalone page (frontend/public/gate.html) that carries the
# Base App link in its own markup, so there is no env var for it. ?gate=1 opens
# the gate while it's off, ?web=1 walks through it while it's on, and dev
# servers never gate.
# VITE_REQUIRE_BASE_APP=true
